// OMO configuration — oh-my-openagent (track: latest stable)
// Subs: Claude Max 5x (anthropic), OpenAI Pro 20x (openai), OpenCode Go (opencode-go)
//
// STRATEGY: primaries NOT pinned -> inherit the plugin's compiled
// AGENT_MODEL_REQUIREMENTS / CATEGORY_MODEL_REQUIREMENTS chains, so model
// generations advance automatically with each plugin release. No edit needed.
//
// KNOWN COST on 4.19.4: its chains predate gpt-6-astra and claude-fable-5-1
// (0 occurrences in the shipped binary). Verified present in 5.0.0-beta.51
// (14 and 6 occurrences) -> resolves itself on the 5.x upgrade, no edit here.
//
// fallback_models STAY pinned: the runtime-fallback hook reads only user
// fallback_models and never the compiled chain, so removing them would
// silently disable mid-session quota failover.
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "codegraph": {},
  "[opencode]": {
    "codegraph": {},
    "model_fallback": true,
    "runtime_fallback": true,
    "agents": {
      "sisyphus": {
        "fallback_models": [
          {
            "model": "opencode-go/kimi-k3"
          },
          {
            "model": "openai/gpt-5.6-sol",
            "variant": "medium"
          },
          {
            "model": "opencode-go/glm-5.2"
          }
        ]
      },
      "metis": {
        "fallback_models": [
